<Window x:Class="EraTrans.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EraTrans"
        Width="1000"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="EraTrans"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,6,0,0"
                       Text="ERA 游戏翻译工具"
                       FontSize="14"
                       Foreground="#68717D" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,24"
                Padding="32"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="提取游戏字典"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#20242A" />
                    <TextBlock Margin="0,6,0,0"
                               Text="读取 CSV、ERB/ERH、ERD、resources 和 XML 文件，按旧版解析规则生成 JSON 字典。"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#68717D" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="游戏目录"
                               VerticalAlignment="Center"
                               Foreground="#39414A" />
                    <TextBox x:Name="GameDirectoryTextBox"
                             Grid.Column="1"
                             Height="34"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0" />
                    <Button Grid.Column="2"
                            Content="选择目录"
                            Height="34"
                            Click="BrowseGameDirectory_Click" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="参考汉化目录"
                               VerticalAlignment="Center"
                               Foreground="#39414A" />
                    <TextBox x:Name="ReferenceDirectoryTextBox"
                             Grid.Column="1"
                             Height="34"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0" />
                    <Button Grid.Column="2"
                            Content="选择目录"
                            Height="34"
                            Click="BrowseReferenceDirectory_Click" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="输出目录"
                               VerticalAlignment="Center"
                               Foreground="#39414A" />
                    <TextBox x:Name="OutputDirectoryTextBox"
                             Grid.Column="1"
                             Height="34"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0" />
                    <Button Grid.Column="2"
                            Content="选择目录"
                            Height="34"
                            Click="BrowseOutputDirectory_Click" />
                </Grid>


                <Grid Grid.Row="4" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="文件编码"
                               VerticalAlignment="Center"
                               Foreground="#39414A" />
                    <ComboBox x:Name="EncodingComboBox"
                              Grid.Column="1"
                              Height="34"
                              VerticalContentAlignment="Center"
                              SelectedIndex="0">
                        <ComboBoxItem Content="UTF-8（含 BOM）" Tag="utf8-bom" />
                        <ComboBoxItem Content="UTF-8" Tag="utf8" />
                        <ComboBoxItem Content="Shift-JIS（日文）" Tag="932" />
                        <ComboBoxItem Content="GBK（简体中文）" Tag="936" />
                        <ComboBoxItem Content="Big5（繁体中文）" Tag="950" />
                    </ComboBox>
                </Grid>
                <Button x:Name="ExtractButton"
                        Grid.Row="5"
                        Content="开始提取"
                        Width="160"
                        Height="40"
                        HorizontalAlignment="Left"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Click="Extract_Click" />

                <TextBlock x:Name="StatusText"
                           Grid.Row="6"
                           Margin="0,16,0,0"
                           Text="游戏目录和参考目录只读；输出目录中的同名 JSON 会被覆盖，不会清理其他文件。"
                           TextWrapping="Wrap"
                           Foreground="#68717D"
                           FontSize="13" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="开发版本 · 当前提供字典提取"
                   FontSize="12"
                   Foreground="#87909B"
                   HorizontalAlignment="Right" />
    </Grid>
</Window>
