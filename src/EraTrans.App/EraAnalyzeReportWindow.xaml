<Window x:Class="EraTrans.App.EraAnalyzeReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="汉化副本引擎体检"
        Width="860"
        Height="580"
        MinWidth="680"
        MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="汉化副本引擎体检"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,4,0,0"
                       Text="调用无头 Emuera 分析工具（era-analyze）对游戏副本进行只读静态编译检查，不运行游戏、不改动存档。"
                       FontSize="12"
                       Foreground="#68717D"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="12"
                Margin="0,0,0,10"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="108" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="目标游戏副本"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#39414A" />
                <TextBox x:Name="GameCopyPathTextBox"
                         Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                         Height="30"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Background="#FAFBFC" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="era-analyze 路径"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#39414A" />
                <TextBox x:Name="AnalyzerPathTextBox"
                         Grid.Row="2" Grid.Column="1"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Margin="0,0,8,0"
                         ToolTip="可选择从 passed1999/era_mcp Releases 下载的 era-analyze.exe" />
                <Button x:Name="BrowseAnalyzerButton"
                        Grid.Row="2" Grid.Column="2"
                        Content="浏览"
                        Width="68"
                        Height="30"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseAnalyzerButton_Click" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock x:Name="SummaryTextBlock"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#39414A"
                       Text="请选择 era-analyze.exe 并点击「开始体检」。" />
        </DockPanel>

        <Border Grid.Row="3"
                Padding="1"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8">
            <DataGrid x:Name="DiagnosticsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      EnableRowVirtualization="True"
                      BorderThickness="0"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="等级"
                                        Binding="{Binding Severity}"
                                        Width="84">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="文件"
                                        Binding="{Binding File}"
                                        Width="1.2*" />
                    <DataGridTextColumn Header="行号"
                                        Binding="{Binding Line}"
                                        Width="64">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="诊断详情"
                                        Binding="{Binding Message}"
                                        Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RunAnalyzeButton"
                        Content="开始体检"
                        Height="34"
                        Padding="16,0"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="RunAnalyzeButton_Click" />
                <Button x:Name="CancelAnalyzeButton"
                        Content="取消"
                        Height="34"
                        Padding="14,0"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="CancelAnalyzeButton_Click" />
                <Button Content="关闭"
                        Width="78"
                        Height="34"
                        IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
