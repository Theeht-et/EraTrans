<Window x:Class="EraTrans.App.AiModelPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择 AI 模型"
        Width="920"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="可用模型列表"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="#20242A" />
                <TextBlock x:Name="ModelCountTextBlock"
                           Margin="0,4,0,0"
                           Text="选择一个对话模型。"
                           FontSize="12"
                           Foreground="#68717D" />
            </StackPanel>
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     Height="34"
                     Margin="12,4,0,0"
                     Padding="9,0"
                     VerticalContentAlignment="Center"
                     ToolTip="按模型名称、ID 或系列搜索"
                     TextChanged="SearchTextBox_TextChanged" />
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E1E5E9"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <ListView x:Name="ModelsListView"
                      BorderThickness="0"
                      Background="Transparent"
                      SelectionMode="Single"
                      SelectionChanged="ModelsListView_SelectionChanged"
                      MouseDoubleClick="ModelsListView_MouseDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="MinHeight" Value="44" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Padding="8,6"
                                        Margin="0,6,0,4"
                                        Background="#EFF2F5"
                                        CornerRadius="5">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="#39414A" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#20242A"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Margin="14,0,4,0">
                                <TextBlock Text="{Binding ContextLimitLabel}"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBlock Text="{Binding ReasoningSupportDescription}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionHintTextBlock"
                       VerticalAlignment="Center"
                       Text="嵌入模型与重排模型只能查看，不能用于当前翻译。"
                       FontSize="11"
                       Foreground="#7A8490"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button x:Name="UseModelButton"
                        Content="使用此模型"
                        Width="112"
                        Height="36"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="UseModel_Click" />
                <Button Content="取消"
                        Width="82"
                        Height="36"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
