        ; You can fight back but he will often get the first shot.
        ; If you give the robber the money you lose what you have currently made and ends your stall run.
        IF !RAND:3 00 && nRyona
            SETCOLOR C_L_GRAY
            P = 1000
            VARSET FactionRaidRankSpawn
            CALL FactionEnemySpawn(12,P,0)
            PRINTFORML A robber comes to your stall and points a %GET_STR(FREE_MOB_SLOT(1), "Weapon", EQUIP:(FREE_MOB_SLOT(1)):Weapon, "名前")% at you. %HE_SHE(FREE_MOB_SLOT(1),1)% demands that you forfeit your earnings and give it to %HIM_HER(FREE_MOB_SLOT(1))%...
