<Window x:Class="EraTrans.App.DictionaryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字典编辑器"
        Width="1480"
        Height="880"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="JSON 字典编辑器"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,5,0,0"
                       Text="只编辑非变量词条的译文和翻译状态。key、original、context 及其他原始字段会保留。"
                       FontSize="13"
                       Foreground="#68717D" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="White"
                    BorderBrush="#E3E6EA"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="字典文件"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />
                        <TextBlock x:Name="DictionaryDirectoryTextBlock"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="#87909B"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox x:Name="DictionaryFilesListBox"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="DictionaryFilesListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativePath}"
                                           Padding="7,8"
                                           TextWrapping="Wrap"
                                           Foreground="#39414A" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    Background="White"
                    BorderBrush="#E3E6EA"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedFileTextBlock"
                                       Text="请选择左侧字典文件"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#20242A" />
                            <TextBlock x:Name="SummaryTextBlock"
                                       Margin="0,4,0,0"
                                       Text="尚未加载字典"
                                       FontSize="12"
                                       Foreground="#68717D" />
                        </StackPanel>
                        <TextBox x:Name="EntrySearchTextBox"
                                 Grid.Column="1"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 Margin="8,0,0,0"
                                 ToolTip="搜索 key、原文、译文或上下文"
                                 TextChanged="EntrySearchTextBox_TextChanged" />
                    </Grid>

                    <DataGrid x:Name="EntriesDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              SelectionUnit="CellOrRowHeader"
                              SelectionMode="Extended"
                              IsReadOnly="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key"
                                                Binding="{Binding Key}"
                                                IsReadOnly="True"
                                                Width="190" />
                            <DataGridTextColumn Header="原文"
                                                Binding="{Binding Original}"
                                                IsReadOnly="True"
                                                Width="2*" />
                            <DataGridTemplateColumn Header="译文" Width="2.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Translation}"
                                                   Padding="5,4"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Translation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsEditable}"
                                                 Padding="5,4"
                                                 MinHeight="32"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="翻译状态" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StageDescription}"
                                                   Padding="5,4"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding StageOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsEditable}"
                                                  MinWidth="120"
                                                  Padding="4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="上下文"
                                                Binding="{Binding Context}"
                                                IsReadOnly="True"
                                                Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusTextBlock"
                                   VerticalAlignment="Center"
                                   Text="变量类词条只读；状态值：-1 忽略、0 未翻译、1 已翻译。"
                                   TextWrapping="Wrap"
                                   Foreground="#68717D"
                                   FontSize="12" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button x:Name="SaveButton"
                                    Content="保存当前字典"
                                    Width="140"
                                    Height="36"
                                    Margin="0,0,10,0"
                                    IsEnabled="False"
                                    Click="SaveButton_Click" />
                            <Button Content="关闭"
                                    Width="90"
                                    Height="36"
                                    Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Text="保存前会检查文件是否被其他程序修改；检测到外部更改时会取消保存，防止覆盖。"
                   Foreground="#87909B"
                   FontSize="11" />
    </Grid>
</Window>
