<Window x:Class="EraTrans.App.AiProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 服务商" Width="1060" Height="810" MinWidth="900" MinHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False" Background="#F4F6F8"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="AI 服务商" FontSize="23" FontWeight="SemiBold" Foreground="#20242A"/>
            <TextBlock Text="管理用于游戏文本翻译的模型服务。默认请求路径为 /chat/completions，模型列表路径为 /models，均可按服务商文档调整。"
                       Margin="0,5,0,0" FontSize="12" Foreground="#68717D" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E1E5E9" BorderThickness="1"
                    CornerRadius="9" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="已添加的服务商" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="#303740"/>
                            <Button x:Name="AddProviderButton" Grid.Column="1"
                                    Content="＋ 添加" Width="72" Height="30"
                                    HorizontalAlignment="Right"
                                    Click="AddProvider_Click"/>
                        </Grid>
                        <TextBlock x:Name="ActiveProviderStatusTextBlock" Grid.Row="1"
                                   Text="当前翻译服务：未配置" Margin="0,8,0,0"
                                   FontSize="11" Foreground="#68717D"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <ListBox x:Name="ProviderListBox" Grid.Row="1" BorderThickness="0"
                             Background="Transparent" SelectionMode="Single" AllowDrop="True"
                             SelectionChanged="ProviderListBox_SelectionChanged"
                             PreviewMouseLeftButtonDown="ProviderListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ProviderListBox_PreviewMouseMove"
                             DragOver="ProviderListBox_DragOver" Drop="ProviderListBox_Drop"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="10,9"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EDF3FA"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#D4E1F0"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F3F6F9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#29313A" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Model}" Margin="0,3,0,0" FontSize="10"
                                                   Foreground="#68717D" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EnabledStatusTextBlock" Text="已启用 · 配置完整"
                                                   Margin="0,4,0,0" FontSize="10" Foreground="#26834A"
                                                   Visibility="Collapsed"/>
                                        <TextBlock x:Name="PendingStatusTextBlock" Text="已启用 · 待配置"
                                                   Margin="0,4,0,0" FontSize="10" Foreground="#A66B18"/>
                                        <TextBlock x:Name="DisabledStatusTextBlock" Text="已禁用"
                                                   Margin="0,4,0,0" FontSize="10" Foreground="#87909B"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Tag="{Binding}" Margin="8,0,0,0"
                                            Padding="9,4" VerticalAlignment="Center"
                                            Click="ToggleProviderEnabled_Click">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Content" Value="禁用"/>
                                                <Setter Property="MinWidth" Value="52"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Content" Value="启用"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                            <Condition Binding="{Binding IsReadyForTranslation}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="EnabledStatusTextBlock" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="PendingStatusTextBlock" Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter TargetName="EnabledStatusTextBlock" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="PendingStatusTextBlock" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="DisabledStatusTextBlock" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="RemoveProviderButton" Grid.Row="2" Content="删除当前服务商"
                            Height="34" Margin="2,10,2,0" Click="RemoveProvider_Click"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E1E5E9" BorderThickness="1"
                    CornerRadius="9" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock x:Name="ProviderTitleTextBlock" Text="服务商配置" FontSize="19"
                                   FontWeight="SemiBold" Foreground="#20242A"/>
                    </StackPanel>
                    <Border x:Name="LegacyProtocolWarning" Grid.Row="1" Visibility="Collapsed"
                            Background="#FFF7E8" BorderBrush="#F1D8A8" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="0,0,0,14">
                        <TextBlock Text="检测到这是旧版 Gemini / Claude 原生协议配置。本版本已统一为 OpenAI 兼容接口；请将 API 地址更换为该服务商的 OpenAI 兼容地址，否则无法连接。原 API Key 和模型 ID 已保留。"
                                   Foreground="#77551E" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,0,0,14">
                        <TextBlock Text="服务商名称" Margin="0,0,0,6" FontSize="12" Foreground="#39414A"/>
                        <TextBox x:Name="ProviderNameTextBox" Height="36" Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="内置服务商名称固定；自定义服务商可以自行命名。"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,0,0,14">
                        <TextBlock Text="API Base URL" Margin="0,0,0,6" FontSize="12" Foreground="#39414A"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BaseUrlTextBox" Height="36" Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="ConnectionEndpointTextChanged"
                                     ToolTip="填写服务商提供的 API 根地址/版本前缀，例如 https://api.example.com/v1。"/>
                            <Button x:Name="RestoreDefaultBaseUrlButton" Grid.Column="1"
                                    Content="恢复默认" Width="82" Height="36" Margin="8,0,0,0"
                                    Click="RestoreDefaultBaseUrl_Click" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock Text="API 路径默认值会自动拼接在 Base URL 后面；请按服务商文档修改，不要把完整地址重复填入。"
                                   Margin="0,7,0,0" FontSize="10" Foreground="#7A8490"
                                   TextWrapping="Wrap"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="聊天 API 路径" Margin="0,0,0,5" FontSize="11" Foreground="#39414A"/>
                                <TextBox x:Name="ChatCompletionsPathTextBox" Height="34" Padding="9,0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="ConnectionEndpointTextChanged"
                                         ToolTip="默认 /chat/completions；连接测试和翻译使用此路径。"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="模型列表 API 路径" Margin="0,0,0,5" FontSize="11" Foreground="#39414A"/>
                                <TextBox x:Name="ModelsPathTextBox" Height="34" Padding="9,0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="ConnectionEndpointTextChanged"
                                         ToolTip="默认 /models；获取模型使用此路径。"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="EndpointPreviewTextBlock" Margin="0,7,0,0"
                                   FontSize="10" Foreground="#536273" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Margin="0,0,0,14">
                        <TextBlock Text="API Key" Margin="0,0,0,6" FontSize="12" Foreground="#39414A"/>
                        <PasswordBox x:Name="ApiKeyPasswordBox" Height="36" Padding="10,0"
                                     VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Margin="0,0,0,10">
                        <TextBlock Text="翻译模型" Margin="0,0,0,6" FontSize="12" Foreground="#39414A"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ModelTextBox" Height="36" Padding="10,0"
                                     VerticalContentAlignment="Center" TextChanged="ModelTextChanged"
                                     ToolTip="填写模型 ID，也可以获取模型列表后选择。"/>
                            <Button x:Name="FetchModelsButton" Grid.Column="1" Content="获取模型"
                                    Width="104" Height="36" Margin="9,0,0,0" Click="FetchModels_Click"/>
                        </Grid>
                        <TextBlock x:Name="ModelCountTextBlock" Text="模型列表尚未获取，可直接填写模型 ID。"
                                   Margin="0,7,0,0" FontSize="11" Foreground="#7A8490" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Row="6" Margin="0,2,0,8" Padding="12,9" Background="#F7F8FA" BorderBrush="#E7EAEE" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="推理设置" FontSize="12" FontWeight="SemiBold" Foreground="#39414A"/>
                                <TextBlock Text="仅在模型明确提供推理档位时生效；未知能力不会发送推理参数。" Margin="0,3,10,0" FontSize="10" Foreground="#7A8490" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ReasoningEnabledCheckBox" Content="启用推理" VerticalAlignment="Center" Margin="0,0,12,0" IsEnabled="False" Checked="ReasoningCheckBoxChanged" Unchecked="ReasoningCheckBoxChanged"/>
                                <ComboBox x:Name="ReasoningEffortComboBox" Width="104" Height="30" IsEnabled="False" SelectionChanged="ReasoningEffortChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="StatusTextBlock" Grid.Row="7" Margin="0,6,0,0"
                               VerticalAlignment="Top" FontSize="12" Foreground="#68717D"
                               TextWrapping="Wrap"/>
                    <Grid Grid.Row="8" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="SetCurrentProviderButton" Content="设为翻译服务"
                                    Width="112" Height="36" Margin="0,0,8,0"
                                    Click="SetCurrentProvider_Click"/>
                            <Button x:Name="TestButton" Content="测试连接" Width="88" Height="36"
                                    Margin="0,0,8,0" Click="TestConnection_Click"/>
                            <Button x:Name="SaveButton" Content="保存" Width="72" Height="36"
                                    Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
                            <Button x:Name="CancelWindowButton" Content="取消" Width="72" Height="36"
                                    IsCancel="True" Click="Cancel_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Margin="2,12,0,0"
                   Text="API Key 使用当前 Windows 用户 DPAPI 加密保存在本机；服务商配置不会上传到其他服务器。"
                   FontSize="11" Foreground="#7A8490" TextWrapping="Wrap"/>
    </Grid>
</Window>