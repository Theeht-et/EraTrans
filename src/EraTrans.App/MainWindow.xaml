<Window x:Class="EraTrans.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EraTrans"
        Width="1560"
        Height="1000"
        MinWidth="1200"
        MinHeight="760"
        Icon="pack://application:,,,/Assets/game-translator-icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        Closing="MainWindow_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="10" Background="White"
                    BorderBrush="#E3E6EA" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="34" /></Grid.RowDefinitions>
                    <TextBlock Text="原游戏目录" FontSize="12" FontWeight="SemiBold"
                               Foreground="#39414A" Margin="0,0,0,6" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="GameDirectoryTextBox" Height="34" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,8,0" />
                        <Button Grid.Column="1" x:Name="BrowseGameDirectoryButton" Content="浏览"
                                Height="34" Click="BrowseGameDirectory_Click" />
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Padding="10" Background="White"
                    BorderBrush="#E3E6EA" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="34" /></Grid.RowDefinitions>
                    <TextBlock Text="统一输出目录" FontSize="12" FontWeight="SemiBold"
                               Foreground="#39414A" Margin="0,0,0,6" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputDirectoryTextBox" Height="34" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,8,0" />
                        <Button Grid.Column="1" x:Name="BrowseOutputDirectoryButton" Content="浏览"
                                Height="34" Click="BrowseOutputDirectory_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenWorkspaceButton" Content="打开工作区" Width="112" Height="38"
                    Margin="0,0,10,0" FontWeight="SemiBold" Click="OpenWorkspace_Click" />
            <Button x:Name="ExtractButton" Grid.Column="1" Content="提取/更新字典" Width="140" Height="38"
                    Margin="0,0,10,0" FontWeight="SemiBold" Click="Extract_Click" />
            <Button x:Name="ApplyTranslationsButton" Grid.Column="2" Content="生成游戏副本并应用译文"
                    Width="205" Height="38" Margin="0,0,10,0" FontWeight="SemiBold"
                    Click="ApplyTranslations_Click" />
            <Button x:Name="SaveCurrentDictionaryButton" Grid.Column="3" Content="保存当前字典"
                    Width="128" Height="38" Margin="0,0,14,0" IsEnabled="False"
                    Click="SaveCurrentDictionary_Click" />
            <TextBlock x:Name="StatusText" Grid.Column="4" VerticalAlignment="Center"
                       Text="原游戏目录不会被修改；字典、AI 上下文和游戏副本会按游戏文件夹名称分类保存。"
                       TextWrapping="Wrap" Foreground="#68717D" FontSize="12" />
            <Button Grid.Column="5" x:Name="SettingsButton" Content="解析设置"
                    Width="100" Height="38" Margin="10,0,0,0"
                    VerticalAlignment="Center" Click="Settings_Click" />
        </Grid>

        <ContentControl x:Name="EditorHost" Grid.Row="2" Margin="0,14,0,0" />
    </Grid>
</Window>
