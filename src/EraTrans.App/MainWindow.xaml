<Window x:Class="EraTrans.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EraTrans"
        Width="1000"
        Height="700"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="EraTrans"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,6,0,0"
                       Text="ERA 游戏字典提取、编辑与安全应用"
                       FontSize="14"
                       Foreground="#68717D" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,24"
                Padding="32"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="游戏目录与统一输出目录"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#20242A" />
                    <TextBlock Margin="0,6,0,0"
                               Text="只需选择原游戏目录和输出目录。字典及其他生成文件统一保存在输出目录；需要汉化或转码时，先将整个原游戏目录完整复制到“游戏副本”，再修改副本，原游戏目录始终只读。"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#68717D" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="原游戏目录"
                               VerticalAlignment="Center"
                               Foreground="#39414A" />
                    <TextBox x:Name="GameDirectoryTextBox"
                             Grid.Column="1"
                             Height="34"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0" />
                    <Button Grid.Column="2"
                            Content="选择目录"
                            Height="34"
                            Click="BrowseGameDirectory_Click" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="输出目录"
                               VerticalAlignment="Center"
                               Foreground="#39414A" />
                    <TextBox x:Name="OutputDirectoryTextBox"
                             Grid.Column="1"
                             Height="34"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0" />
                    <Button Grid.Column="2"
                            Content="选择目录"
                            Height="34"
                            Click="BrowseOutputDirectory_Click" />
                </Grid>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            Margin="0,0,0,4">
                    <Button x:Name="ExtractButton"
                            Content="开始提取字典"
                            Width="160"
                            Height="40"
                            Margin="0,0,12,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Click="Extract_Click" />
                    <Button x:Name="ApplyTranslationsButton"
                            Content="完整复制游戏并应用译文"
                            Width="210"
                            Height="40"
                            Margin="0,0,12,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Click="ApplyTranslations_Click" />
                    <Button x:Name="EditDictionaryButton"
                            Content="编辑字典"
                            Width="110"
                            Height="40"
                            Margin="0,0,12,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Click="EditDictionary_Click" />
                    <Button x:Name="SettingsButton"
                            Content="设置"
                            Width="90"
                            Height="40"
                            FontSize="14"
                            Click="Settings_Click" />
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           Grid.Row="4"
                           Margin="0,16,0,0"
                           Text="输出目录自动管理字典和游戏副本；原游戏目录不会被修改。"
                           TextWrapping="Wrap"
                           Foreground="#68717D"
                           FontSize="13" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="开发版本 · 原游戏只读，所有生成文件统一输出"
                   FontSize="12"
                   Foreground="#87909B"
                   HorizontalAlignment="Right" />
    </Grid>
</Window>
