<Window x:Class="EraTrans.App.ParserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提取与写回"
        Width="840"
        Height="760"
        MinWidth="680"
        MinHeight="560"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F5F6F8">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="提取与写回"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,5,0,0"
                       Text="调整文本提取、译文写回与 AI 翻译方式，保存后生效。"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#68717D" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="通用设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"
                                   Margin="0,0,0,14" />

                        <TextBlock Grid.Row="1"
                                   Text="文本抽取方式"
                                   VerticalAlignment="Center"
                                   Foreground="#39414A" />
                        <ComboBox x:Name="ExtractionModeComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Height="34"
                                  Margin="0,0,0,6"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="ExtractionModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="旧版（按字符规则提取）" Tag="legacy" />
                            <ComboBoxItem Content="新版（推荐，仅提取玩家可见文本）" Tag="lexer" />
                        </ComboBox>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="仅影响 ERB 脚本；新版与旧版的字典分开存放，互不覆盖。"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D"
                                   Margin="0,0,0,12" />

                        <Expander Grid.Row="3"
                                  Grid.ColumnSpan="2"
                                  Header="高级编码设置（默认 Shift-JIS，一般无需修改）"
                                  Margin="0,0,0,12"
                                  Foreground="#39414A">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="游戏原始编码（无 BOM 文件）"
                                           VerticalAlignment="Center"
                                           Foreground="#39414A" />
                                <ComboBox x:Name="EncodingComboBox"
                                          Grid.Column="1"
                                          Height="34"
                                          Margin="0,0,0,6"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Shift-JIS（日文）" Tag="932" />
                                    <ComboBoxItem Content="GBK（简体中文）" Tag="936" />
                                    <ComboBoxItem Content="Big5（繁体中文）" Tag="950" />
                                </ComboBox>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="UTF-8 / UTF-16 会自动识别；仅在读取无 BOM 的简体（GBK）或繁体（Big5）改版游戏时才需切换。"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#68717D" />
                            </Grid>
                        </Expander>

                        <CheckBox x:Name="WriteContextCheckBox"
                                  Grid.Row="5"
                                  Content="提取字典时写入上下文"
                                  ToolTip="保存原脚本行作为上下文，帮助人工校对和 AI 理解语境"
                                  Foreground="#39414A" />
                        <CheckBox x:Name="AutoOpenFolderCheckBox"
                                  Grid.Row="5"
                                  Grid.Column="1"
                                  Content="处理完成后自动打开结果目录"
                                  ToolTip="提取或生成副本后自动打开对应文件夹"
                                  Foreground="#39414A" />
                    </Grid>
                </Border>

                <Border x:Name="LexerSettingsPanel"
                        Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="新版提取设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"
                                   Margin="0,0,0,12" />

                        <CheckBox x:Name="ExtractHtmlTitleCheckBox"
                                  Content="提取 HTML 悬停提示（title）"
                                  ToolTip="提取鼠标悬停时显示的提示文字，不影响按钮内部返回值"
                                  Foreground="#39414A"
                                  Margin="0,0,0,10" />
                        <CheckBox x:Name="ExtractPrintDataEntriesCheckBox"
                                  Content="提取 PRINTDATA / DATALIST 随机文本块"
                                  ToolTip="提取随机文本块中的所有候选句子"
                                  Foreground="#39414A"
                                  Margin="0,0,0,10" />
                        <CheckBox x:Name="SkipNonJapaneseEntriesCheckBox"
                                  Content="跳过不含日文的条目（纯英文、纯符号）"
                                  ToolTip="跳过如 &quot;OK&quot;、&quot;EXP+5&quot; 等通常无需翻译的内容"
                                  Foreground="#39414A" />
                    </StackPanel>
                </Border>

                <Border x:Name="LegacySettingsPanel"
                        Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="旧版提取设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />

                        <TextBlock Text="仅旧版模式生效，一般保持默认即可。"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="HideEnglishTextCheckBox"
                                      Content="隐藏英文词条"
                                      ToolTip="隐藏纯英文词条，不参与翻译"
                                      Margin="0,0,10,10"
                                      Foreground="#39414A" />
                            <CheckBox x:Name="MergeDuplicateEntriesCheckBox"
                                      Grid.Column="1"
                                      Content="合并同一文件中的相同词条"
                                      ToolTip="同一文件里完全相同的句子只保留一条"
                                      Margin="0,0,0,10"
                                      Foreground="#39414A" />
                            <CheckBox x:Name="HideVariableEntriesCheckBox"
                                      Grid.Row="1"
                                      Content="屏蔽变量词条输出"
                                      ToolTip="过滤疑似变量名的条目，避免误翻代码"
                                      Margin="0,0,10,0"
                                      Foreground="#39414A" />
                            <CheckBox x:Name="MergeConcatenatedStringsCheckBox"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      Content="合并联立字符串"
                                      ToolTip="合并拼接字符串，建议保持默认"
                                      Foreground="#39414A" />
                        </Grid>

                        <Expander Header="高级解析规则（仅旧版）"
                                  Margin="0,14,0,0"
                                  Foreground="#39414A">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="直接影响旧版脚本拆分规则，不熟悉 ERA 语法请保持默认。"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#68717D"
                                           Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="允许构成变量名的字符（每行一个）"
                                                   Margin="0,0,0,5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#39414A" />
                                        <TextBox x:Name="VariableNameCharactersTextBox"
                                                 Height="150"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 Padding="8"
                                                 FontFamily="Consolas" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="需要处理的操作符（每行一个）"
                                                   Margin="0,0,0,5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#39414A" />
                                        <TextBox x:Name="OperatorsTextBox"
                                                 Height="150"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 Padding="8"
                                                 FontFamily="Consolas" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="EnableVariableAutoCorrectionCheckBox"
                                          Content="旧版变量自动修正（高风险，默认关闭）"
                                          ToolTip="旧版遗留功能：写回后用下方 CSV 词典对脚本做全文替换，可能误伤同名台词；新版已改用显示层变量名封装，无需开启"
                                          Foreground="#39414A"
                                          Margin="0,12,0,8" />

                                <TextBlock Text="变量自动修正参考文件（每行一个，不含 .json）"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBox x:Name="AutoReplaceReferenceFilesTextBox"
                                         Height="88"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Padding="8"
                                         FontFamily="Consolas" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="写回设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />
                        <TextBlock Text="新版按精确位置写回，旧版及 CSV 等文件按原文匹配写回。"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D" />

                        <CheckBox x:Name="EnableDisplayNameTranslationInjectionCheckBox"
                                  Content="显示层变量名封装（不改 CSV）"
                                  ToolTip="根据「变量术语」中已定稿译名，自动在副本中安全封装显示位 %XXXNAME:...%，原 CSV 与脚本逻辑保持不变"
                                  Foreground="#39414A"
                                  Margin="0,0,0,12" />

                        <StackPanel>
                            <TextBlock Text="游戏文件扩展名（每行一个）"
                                       Margin="0,0,0,5"
                                       FontWeight="SemiBold"
                                       Foreground="#39414A" />
                            <TextBox x:Name="TargetFileExtensionsTextBox"
                                     Height="88"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Padding="8"
                                     FontFamily="Consolas" />
                            <TextBlock Text="必须保留 .erb，否则脚本译文不会写回。"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="#68717D" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="AI 翻译方式"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />

                        <CheckBox x:Name="EnableErbSemanticGroupingTranslationCheckBox"
                                  Content="按原文顺序整段翻译（按屏分窗）"
                                  ToolTip="开启：按游戏一屏对话整段发给 AI，上下文更连贯。关闭：固定每 12 条一批翻译。"
                                  Margin="0,12,0,6"
                                  Foreground="#39414A" />

                        <TextBlock Text="整段翻译需要分组文件（新版提取时自动生成）。"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="每个窗口的字符上限"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBox x:Name="WindowMaxCharactersTextBox"
                                         Height="32"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="默认 3000，越小切分越细" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="每个窗口的行数上限"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBox x:Name="WindowMaxLinesTextBox"
                                         Height="32"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="默认 60，防止短句过多拉长单次请求" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="同时发送的请求数"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBox x:Name="TranslationConcurrencyTextBox"
                                         Height="32"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="1–50，默认 1。调高可加快批量翻译，过高可能触发接口限流" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="前两项仅对「整段翻译」生效；并发数对所有模式生效。"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="保存后在下次提取或生成副本时生效"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#87909B"
                       FontSize="11" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="保存设置"
                        Width="100"
                        Height="36"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click" />
                <Button Content="取消"
                        Width="82"
                        Height="36"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
