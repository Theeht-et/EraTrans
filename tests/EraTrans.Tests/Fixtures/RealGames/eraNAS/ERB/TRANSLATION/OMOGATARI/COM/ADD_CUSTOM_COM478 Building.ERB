        PRINTL
        PRINTFORM Toilet:
        IF IS_TOILET(CFLAG:MASTER:300, MASTER) == 1
            PRINTFORMS "Prebuilt toilet"
            SIF DT_SELECT("ToiletBuilding",@"area={CFLAG:MASTER:300}")
                PRINTFORMS " + Potty chair"
        ELSE
            PRINTFORML [400] - Add potty chair
        ENDIF
        PRINTFORML [402] - Potty chair config (applies to all potties)
        PRINTL
        PRINTL
        PRINTFORML [999] - Exit
        CALL GET_ITEM_NAS("PottyChair", 1, 1)
        PRINTFORMW You remove the potty chair to %NAME_FROM_PLACE_THE(CFLAG:MASTER:300)%
        DT_ROW_REMOVE "ToiletBuilding", RESULT:1
        CASE 402
            CALL PottyChairBlacklistConfig
        CASE 999
            RETURN 1
        ENDSELECT
