<Window x:Class="EraTrans.App.DictionaryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字典编辑器"
        Width="1480"
        Height="880"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="JSON 字典编辑器"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,5,0,0"
                       Text="只编辑非变量词条的译文和翻译状态。key、original、context 及其他原始字段会保留。"
                       FontSize="13"
                       Foreground="#68717D" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="White"
                    BorderBrush="#E3E6EA"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="字典文件"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />
                        <TextBlock x:Name="DictionaryDirectoryTextBlock"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="#87909B"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TreeView x:Name="DictionaryFilesTreeView"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="DictionaryFilesTreeView_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    Background="White"
                    BorderBrush="#E3E6EA"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="190" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedFileTextBlock"
                                       Text="请选择左侧字典文件"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#20242A" />
                            <TextBlock x:Name="SummaryTextBlock"
                                       Margin="0,4,0,0"
                                       Text="尚未加载字典"
                                       FontSize="12"
                                       Foreground="#68717D" />
                        </StackPanel>
                        <TextBox x:Name="EntrySearchTextBox"
                                 Grid.Column="1"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 Margin="8,0,0,0"
                                 ToolTip="搜索 key、原文、译文或上下文"
                                 TextChanged="EntrySearchTextBox_TextChanged" />
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock x:Name="AiProviderStatusTextBlock"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#68717D"
                                   FontSize="11"
                                   Text="AI 翻译未配置" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AiSettingsButton"
                                    Content="AI 服务设置"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Click="AiSettingsButton_Click" />
                            <Button x:Name="TranslateSelectedButton"
                                    Content="翻译选中"
                                    Width="100"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Click="TranslateSelectedButton_Click" />
                            <Button x:Name="TranslatePendingButton"
                                    Content="批量翻译未翻译项"
                                    Width="150"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Click="TranslatePendingButton_Click" />
                            <Button x:Name="CancelTranslationButton"
                                    Content="取消翻译"
                                    Width="90"
                                    Height="32"
                                    IsEnabled="False"
                                    Click="CancelTranslationButton_Click" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid x:Name="EntriesDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              SelectionUnit="CellOrRowHeader"
                              SelectionMode="Extended"
                              IsReadOnly="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="EntriesDataGrid_SelectionChanged"
                              CurrentCellChanged="EntriesDataGrid_CurrentCellChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key"
                                                Binding="{Binding Key}"
                                                IsReadOnly="True"
                                                Width="190" />
                            <DataGridTextColumn Header="语义组"
                                                Binding="{Binding SemanticGroupLabel}"
                                                IsReadOnly="True"
                                                Width="125" />
                            <DataGridTextColumn Header="原文"
                                                Binding="{Binding Original}"
                                                IsReadOnly="True"
                                                Width="2*" />
                            <DataGridTemplateColumn Header="译文" Width="2.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Translation}"
                                                   Padding="5,4"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Translation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsEditable}"
                                                 Padding="5,4"
                                                 MinHeight="32"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="翻译状态" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StageDescription}"
                                                   Padding="5,4"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding StageOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsEditable}"
                                                  MinWidth="120"
                                                  Padding="4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="76" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="编辑"
                                                Height="28"
                                                Padding="10,0"
                                                Margin="4,2"
                                                IsEnabled="{Binding IsEditable}"
                                                Click="EditTranslationButton_Click"
                                                ToolTip="在大编辑窗口中查看和编辑完整译文" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" Background="#FAFBFC" BorderBrush="#E3E6EA" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="68" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="EntryGroupLabelTextBlock" Text="同组条目"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#39414A" Margin="0,0,0,4" />
                            <TextBox x:Name="EntryGroupTextBox" Grid.Row="1" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="当前词条没有可用的 ERB 语义分组信息。" />
                            <TextBlock Grid.Row="2" Text="当前词条上下文"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#39414A"
                                       Margin="0,5,0,4" />
                            <TextBox x:Name="EntryContextTextBox" Grid.Row="3" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="选择一个词条查看上下文。" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusTextBlock"
                                   VerticalAlignment="Center"
                                   Text="变量类词条只读；状态值：-1 忽略、0 未翻译、1 已翻译。"
                                   TextWrapping="Wrap"
                                   Foreground="#68717D"
                                   FontSize="12" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button x:Name="SaveButton"
                                    Content="保存当前字典"
                                    Width="140"
                                    Height="36"
                                    Margin="0,0,10,0"
                                    IsEnabled="False"
                                    Click="SaveButton_Click" />
                            <Button Content="关闭"
                                    Width="90"
                                    Height="36"
                                    Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Text="AI 结果仅回填当前编辑器，不会自动保存；变量、已有译文和已忽略词条均会跳过。保存前仍会检查文件是否被外部修改。"
                   Foreground="#87909B"
                   FontSize="11" />
    </Grid>
</Window>