<Window x:Class="EraTrans.App.ParserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EraTrans.App"
        Title="提取与写回"
        Width="840"
        Height="740"
        MinWidth="680"
        MinHeight="560"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F5F6F8">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="提取与写回"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,5,0,0"
                       Text="调整文本提取、译文写回与 AI 翻译方式，保存后生效。"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#68717D" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="通用设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"
                                   Margin="0,0,0,14" />

                        <TextBlock Grid.Row="1"
                                   Text="文本抽取方式"
                                   VerticalAlignment="Center"
                                   Foreground="#39414A" />
                        <ComboBox x:Name="ExtractionModeComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Height="34"
                                  Margin="0,0,0,6"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="ExtractionModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="旧版（按字符规则提取）" Tag="legacy" />
                            <ComboBoxItem Content="新版（推荐，仅提取玩家可见文本）" Tag="lexer" />
                        </ComboBox>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="新版会自动跳过代码和图片编号，只提取玩家能看到的对话与角色信息；两版字典分开存放，互不覆盖。"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D"
                                   Margin="0,0,0,12" />

                        <Expander Grid.Row="3"
                                  Grid.ColumnSpan="2"
                                  Header="高级编码设置（默认 Shift-JIS，一般无需修改）"
                                  Margin="0,0,0,12"
                                  Foreground="#39414A">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="游戏默认文字编码"
                                           VerticalAlignment="Center"
                                           Foreground="#39414A" />
                                <ComboBox x:Name="EncodingComboBox"
                                          Grid.Column="1"
                                          Height="34"
                                          Margin="0,0,0,6"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Shift-JIS（日文）" Tag="932" />
                                    <ComboBoxItem Content="GBK（简体中文）" Tag="936" />
                                    <ComboBoxItem Content="Big5（繁体中文）" Tag="950" />
                                </ComboBox>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="绝大多数日文原版游戏保持「Shift-JIS」即可；仅在读取中文改版游戏出现乱码时切换。"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#68717D" />
                            </Grid>
                        </Expander>

                        <CheckBox x:Name="WriteContextCheckBox"
                                  Grid.Row="5"
                                  Content="在词典中附带原文所在行"
                                  ToolTip="保存原句所在行作为参考，方便人工校对和 AI 理解前后语境"
                                  Foreground="#39414A" />
                        <CheckBox x:Name="AutoOpenFolderCheckBox"
                                  Grid.Row="5"
                                  Grid.Column="1"
                                  Content="处理完成后自动打开结果目录"
                                  ToolTip="提取字典或生成汉化副本后自动打开对应文件夹"
                                  Foreground="#39414A" />
                    </Grid>
                </Border>

                <Border x:Name="LexerSettingsPanel"
                        Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="新版提取设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"
                                   Margin="0,0,0,12" />

                        <CheckBox x:Name="ExtractHtmlTitleCheckBox"
                                  Content="提取鼠标悬停时的提示文字"
                                  ToolTip="鼠标放到按钮或图标上弹出的说明文字，不影响按钮本身功能。建议保持开启"
                                  Foreground="#39414A"
                                  Margin="0,0,0,10" />
                        <CheckBox x:Name="ExtractPrintDataEntriesCheckBox"
                                  Content="提取随机对话与随机事件文本"
                                  ToolTip="提取游戏里随机抽取的台词或事件中的所有候选句子。建议保持开启"
                                  Foreground="#39414A"
                                  Margin="0,0,0,10" />
                        <CheckBox x:Name="SkipNonJapaneseEntriesCheckBox"
                                  Content="跳过不含日文的条目（纯英文、纯符号）"
                                  ToolTip="跳过如 &quot;OK&quot;、&quot;EXP+5&quot; 等无需翻译的内容，并过滤掉代码表达式。建议保持开启"
                                  Foreground="#39414A" />
                    </StackPanel>
                </Border>

                <local:LegacyParserSettingsControl x:Name="LegacySettingsControl" />

                <Border Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="写回设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />
                        <TextBlock Text="新版按精确位置写入译文，不会误改代码；旧版按原文匹配替换。"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D" />

                        <CheckBox x:Name="EnableDisplayNameTranslationInjectionCheckBox"
                                  Content="自动替换界面中的道具/技能/属性译名（推荐开启）"
                                  ToolTip="配合「变量术语」窗口里的译名，在游戏界面自动显示中文，同时不破坏原有存档和游戏逻辑"
                                  Foreground="#39414A" />
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="AI 翻译方式"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />

                        <CheckBox x:Name="EnableErbSemanticGroupingTranslationCheckBox"
                                  Content="按原文顺序整段翻译（按屏分窗）"
                                  ToolTip="开启：按游戏一屏对话整段发给 AI，上下文更连贯。关闭：固定每 12 句一批翻译。"
                                  Margin="0,12,0,6"
                                  Foreground="#39414A" />

                        <TextBlock Text="按游戏里同一屏的完整对话一起发给 AI，上下文更连贯（推荐开启）；关闭则固定每 12 句翻译一次。"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="单次发给 AI 的字数上限"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBox x:Name="WindowMaxCharactersTextBox"
                                         Height="32"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="默认 3000，越小单次发送越短" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="单次发给 AI 的句数上限"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBox x:Name="WindowMaxLinesTextBox"
                                         Height="32"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="默认 60，防止短句过多拉长单次请求" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="同时翻译的并发数"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBox x:Name="TranslationConcurrencyTextBox"
                                         Height="32"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="1–50，默认 5。调高可加快批量翻译，过高可能触发接口限流" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="前两项仅在开启「整段翻译」时生效；并发数对所有模式生效。"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="保存后在下次提取或生成副本时生效"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#87909B"
                       FontSize="11" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="保存设置"
                        Width="100"
                        Height="36"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click" />
                <Button Content="取消"
                        Width="82"
                        Height="36"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
