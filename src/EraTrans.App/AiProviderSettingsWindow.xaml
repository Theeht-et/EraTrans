<Window x:Class="EraTrans.App.AiProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 服务商设置"
        Width="900"
        Height="760"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F6F8">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="AI 翻译服务商"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,5,0,0"
                       Text="支持 OpenAI 兼容的 Chat Completions API。模型可手动填写，也可从服务商的 GET /models 接口获取并按系列分组。API Key 使用当前 Windows 用户密钥加密保存。"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#68717D" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="18"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="当前服务商"
                           VerticalAlignment="Center"
                           Foreground="#39414A" />
                <ComboBox x:Name="ProviderComboBox"
                          Grid.Column="1"
                          Height="34"
                          DisplayMemberPath="Name"
                          SelectionChanged="ProviderComboBox_SelectionChanged" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="10,0,0,0">
                    <Button Content="新增"
                            Width="58"
                            Height="34"
                            Margin="0,0,6,0"
                            Click="AddProvider_Click" />
                    <Button Content="删除"
                            Width="58"
                            Height="34"
                            Click="RemoveProvider_Click" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="服务商名称"
                           VerticalAlignment="Center"
                           Margin="0,13,0,0"
                           Foreground="#39414A" />
                <TextBox x:Name="NameTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="34"
                         Margin="0,13,0,0"
                         VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="2"
                           Text="API Base URL"
                           VerticalAlignment="Center"
                           Margin="0,13,0,0"
                           Foreground="#39414A" />
                <TextBox x:Name="BaseUrlTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="34"
                         Margin="0,13,0,0"
                         VerticalContentAlignment="Center"
                         ToolTip="例如：https://api.openai.com/v1" />

                <TextBlock Grid.Row="3"
                           Text="API Key"
                           VerticalAlignment="Center"
                           Margin="0,13,0,0"
                           Foreground="#39414A" />
                <PasswordBox x:Name="ApiKeyPasswordBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             Height="34"
                             Margin="0,13,0,0"
                             VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="4"
                           Text="翻译模型 ID"
                           VerticalAlignment="Center"
                           Margin="0,13,0,0"
                           Foreground="#39414A" />
                <TextBox x:Name="ModelTextBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         Height="34"
                         Margin="0,13,8,0"
                         VerticalContentAlignment="Center"
                         ToolTip="可直接填写模型 ID，也可以从下方获取的模型列表中选择。" />
                <Button x:Name="FetchModelsButton"
                        Grid.Row="4"
                        Grid.Column="2"
                        Content="获取模型"
                        Width="106"
                        Height="34"
                        Margin="0,13,0,0"
                        Click="FetchModels_Click" />

                <TextBlock Grid.Row="5"
                           Text="可用模型"
                           VerticalAlignment="Center"
                           Margin="0,14,0,7"
                           FontWeight="SemiBold"
                           Foreground="#39414A" />
                <TextBox x:Name="ModelsSearchTextBox"
                         Grid.Row="5"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="30"
                         Margin="0,14,0,7"
                         Padding="7,2"
                         VerticalContentAlignment="Center"
                         ToolTip="按模型名称、ID 或提供方筛选"
                         TextChanged="ModelsSearchTextBox_TextChanged" />

                <ListView x:Name="ModelsListView"
                          Grid.Row="6"
                          Grid.ColumnSpan="3"
                          SelectionMode="Single"
                          BorderBrush="#E3E6EA"
                          BorderThickness="1"
                          Background="#FCFCFD"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          MouseDoubleClick="ModelsListView_MouseDoubleClick">
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="7,5" />
                            <Setter Property="MinHeight" Value="48" />
                        </Style>
                    </ListView.Resources>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6"
                                            Margin="0,5,0,2"
                                            Background="#F0F2F5"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#39414A" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#20242A"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Id}"
                                               Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="#68717D"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding MetadataSummary}"
                                           Margin="12,0,4,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#87909B" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="7"
                      Grid.ColumnSpan="3"
                      Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ModelCountTextBlock"
                               VerticalAlignment="Center"
                               Text="尚未获取模型列表。若服务商不支持 GET /models，可在上方手动填写模型 ID。"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#87909B" />
                    <Button x:Name="UseSelectedModelButton"
                            Grid.Column="1"
                            Content="使用选中模型"
                            Height="30"
                            Margin="8,0,0,0"
                            Padding="10,0"
                            IsEnabled="False"
                            Click="UseSelectedModel_Click" />
                    <TextBlock x:Name="StatusTextBlock"
                               Grid.Column="2"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#68717D"
                               FontSize="11" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="模型列表来自服务商实际返回；嵌入、重排模型仅展示，当前翻译功能只使用对话模型。模型列表获取失败时仍可手动填写 ID。"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#87909B"
                       FontSize="11" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button x:Name="TestButton"
                        Content="测试连接"
                        Width="92"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="TestConnection_Click" />
                <Button Content="保存"
                        Width="82"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="Save_Click" />
                <Button Content="取消"
                        Width="82"
                        Height="36"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>