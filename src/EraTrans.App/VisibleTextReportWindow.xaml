<Window x:Class="EraTrans.App.VisibleTextReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="覆盖率报告"
        UseLayoutRounding="True"
        Width="860"
        Height="680"
        MinWidth="680"
        MinHeight="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="覆盖率报告"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock x:Name="ReportPathTextBlock"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="#87909B"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="12"
                Margin="0,0,0,12"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock x:Name="SummaryTextBlock"
                       FontSize="13"
                       Foreground="#39414A"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="10"
                    Background="White"
                    BorderBrush="#E3E6EA"
                    BorderThickness="1"
                    CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="未识别的疑似文本命令（含日文参数）"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#20242A"
                               Margin="0,0,0,8" />
                    <DataGrid x:Name="UnknownCommandsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="命令名" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="出现行数" Binding="{Binding Lines}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="10"
                    Background="White"
                    BorderBrush="#E3E6EA"
                    BorderThickness="1"
                    CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="变量中转未提取统计（同函数内赋值后打印）"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#20242A"
                               Margin="0,0,0,8" />
                    <DataGrid x:Name="AssignedVarsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="变量名" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="出现行数" Binding="{Binding Lines}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Padding="10"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="未知命令样本行"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#39414A"
                           Margin="0,0,0,6" />
                <TextBox x:Name="SamplesTextBox"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="关闭"
                    Width="88"
                    Height="34"
                    IsCancel="True"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
