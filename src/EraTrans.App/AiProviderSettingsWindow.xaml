<Window x:Class="EraTrans.App.AiProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 服务商设置"
        Width="680"
        Height="500"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F6F8">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="AI 翻译服务商"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,5,0,0"
                       Text="支持 OpenAI 兼容的 Chat Completions API。API Key 会使用当前 Windows 用户密钥加密保存。"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#68717D" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="18"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="当前服务商"
                           VerticalAlignment="Center"
                           Foreground="#39414A" />
                <ComboBox x:Name="ProviderComboBox"
                          Grid.Column="1"
                          Height="34"
                          DisplayMemberPath="Name"
                          SelectionChanged="ProviderComboBox_SelectionChanged" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="10,0,0,0">
                    <Button Content="新增"
                            Width="58"
                            Height="34"
                            Margin="0,0,6,0"
                            Click="AddProvider_Click" />
                    <Button Content="删除"
                            Width="58"
                            Height="34"
                            Click="RemoveProvider_Click" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="服务商名称"
                           VerticalAlignment="Center"
                           Margin="0,14,0,0"
                           Foreground="#39414A" />
                <TextBox x:Name="NameTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="34"
                         Margin="0,14,0,0"
                         VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="2"
                           Text="API Base URL"
                           VerticalAlignment="Center"
                           Margin="0,14,0,0"
                           Foreground="#39414A" />
                <TextBox x:Name="BaseUrlTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="34"
                         Margin="0,14,0,0"
                         VerticalContentAlignment="Center"
                         ToolTip="例如：https://api.openai.com/v1" />

                <TextBlock Grid.Row="3"
                           Text="模型名称"
                           VerticalAlignment="Center"
                           Margin="0,14,0,0"
                           Foreground="#39414A" />
                <TextBox x:Name="ModelTextBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="34"
                         Margin="0,14,0,0"
                         VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="4"
                           Text="API Key"
                           VerticalAlignment="Center"
                           Margin="0,14,0,0"
                           Foreground="#39414A" />
                <PasswordBox x:Name="ApiKeyPasswordBox"
                             Grid.Row="4"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             Height="34"
                             Margin="0,14,0,0"
                             VerticalContentAlignment="Center" />

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="5"
                           Grid.ColumnSpan="3"
                           Margin="0,18,0,0"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Foreground="#68717D"
                           FontSize="12" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Base URL 可填写到 /v1；若误填完整的 /chat/completions 地址会自动去除该路径。"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#87909B"
                       FontSize="11" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button x:Name="TestButton"
                        Content="测试连接"
                        Width="92"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="TestConnection_Click" />
                <Button Content="保存"
                        Width="82"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="Save_Click" />
                <Button Content="取消"
                        Width="82"
                        Height="36"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>