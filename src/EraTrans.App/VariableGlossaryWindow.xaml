<Window x:Class="EraTrans.App.VariableGlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="变量与术语中心"
        Width="860"
        Height="600"
        MinWidth="680"
        MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="变量与术语中心"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,4,0,0"
                       Text="集中管理玩家可见且含假名的 CSV 变量名（纯汉字与内部标志已自动过滤）。保存后将自动作为 AI 翻译术语表按需生效，不会改动原 CSV 变量名。"
                       FontSize="12"
                       Foreground="#68717D"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="116" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox x:Name="SearchTextBox"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         FontSize="12"
                         TextChanged="SearchTextBox_TextChanged" />
                <TextBlock x:Name="SearchPlaceholder"
                           Text="搜索原日文名或中文译名…"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#9AA3AE"
                           IsHitTestVisible="False" />
            </Grid>

            <ComboBox x:Name="TableFilterComboBox"
                      Grid.Column="1"
                      Height="30"
                      Margin="8,0,0,0"
                      VerticalContentAlignment="Center"
                      FontSize="12"
                      SelectionChanged="FilterComboBox_SelectionChanged" />

            <ComboBox x:Name="StatusFilterComboBox"
                      Grid.Column="2"
                      Height="30"
                      Margin="8,0,0,0"
                      VerticalContentAlignment="Center"
                      FontSize="12"
                      SelectionChanged="FilterComboBox_SelectionChanged">
                <ComboBoxItem Content="全部状态" Tag="all" />
                <ComboBoxItem Content="未翻译" Tag="pending" />
                <ComboBoxItem Content="已翻译" Tag="translated" />
            </ComboBox>

            <TextBlock x:Name="StatsTextBlock"
                       Grid.Column="3"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="#59636F"
                       Text="共 0 条" />
        </Grid>

        <Border Grid.Row="2"
                Padding="1"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8">
            <DataGrid x:Name="GlossaryDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      SelectionMode="Extended"
                      EnableRowVirtualization="True"
                      BorderThickness="0"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="所属表"
                                        Binding="{Binding Table}"
                                        IsReadOnly="True"
                                        Width="92">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="#59636F" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="原日文名"
                                        Binding="{Binding Original}"
                                        IsReadOnly="True"
                                        Width="1.2*" />
                    <DataGridTextColumn Header="中文译名（双击编辑）"
                                        Binding="{Binding Translation, UpdateSourceTrigger=PropertyChanged}"
                                        Width="1.5*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RescanCsvButton"
                        Content="重新扫描 CSV"
                        Height="34"
                        Padding="12,0"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RescanCsvButton_Click" />
                <Button x:Name="TranslatePendingButton"
                        Content="AI 批量翻译未翻项"
                        Height="34"
                        Padding="12,0"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="TranslatePendingButton_Click" />
                <Button x:Name="CancelTranslationButton"
                        Content="取消翻译"
                        Height="34"
                        Padding="12,0"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="CancelTranslationButton_Click" />
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#68717D"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="260" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SaveButton"
                        Content="保存词表"
                        Height="34"
                        Padding="16,0"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveButton_Click" />
                <Button Content="关闭"
                        Width="78"
                        Height="34"
                        IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
