<UserControl x:Class="EraTrans.App.DictionaryEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6F8"
             PreviewKeyDown="Control_PreviewKeyDown">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="190" MaxWidth="480" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="White"
                    BorderBrush="#E3E6EA"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="字典文件"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />
                        <TextBlock x:Name="DictionaryDirectoryTextBlock"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="#87909B"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TreeView x:Name="DictionaryFilesTreeView"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="DictionaryFilesTreeView_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Resources>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Cursor="SizeWE"
                          ToolTip="拖动调整左侧文件夹区域宽度">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Border Background="Transparent">
                            <Border Width="2"
                                    HorizontalAlignment="Center"
                                    Background="#D5DAE0"
                                    CornerRadius="1" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Border Grid.Column="2"
                    Padding="14"
                    Background="White"
                    BorderBrush="#E3E6EA"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="160" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedFileTextBlock"
                                       Text="请选择左侧字典文件"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#20242A" />
                            <TextBlock x:Name="SummaryTextBlock"
                                       Margin="0,4,0,0"
                                       Text="尚未加载字典"
                                       FontSize="12"
                                       Foreground="#68717D" />
                        </StackPanel>
                        <TextBox x:Name="EntrySearchTextBox"
                                 Grid.Column="1"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 Margin="8,0,0,0"
                                 ToolTip="搜索 key、原文、译文或上下文"
                                 TextChanged="EntrySearchTextBox_TextChanged" />
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right"
                                    Width="235"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="推理"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           FontSize="11"
                                           Foreground="#68717D" />
                                <ComboBox x:Name="AiReasoningComboBox"
                                          Width="92"
                                          Height="24"
                                          Padding="4,0"
                                          VerticalContentAlignment="Center"
                                          FontSize="11"
                                          SelectionChanged="AiReasoningComboBox_SelectionChanged"
                                          DropDownOpened="AiReasoningComboBox_DropDownOpened"
                                          ToolTip="自动：使用服务商默认设置。开启/关闭：向请求附加当前服务商对应的推理字段。">
                                    <ComboBoxItem Content="自动" Tag="auto" />
                                    <ComboBoxItem Content="开启" Tag="on" />
                                    <ComboBoxItem Content="关闭" Tag="off" />
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="AiProviderStatusTextBlock"
                                       Margin="0,4,0,0"
                                       Foreground="#68717D"
                                       FontSize="11"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       Text="AI 翻译未配置" />
                            <TextBlock x:Name="StatusTextBlock"
                                       Foreground="#68717D"
                                       FontSize="11"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       MaxHeight="30"
                                       Text="就绪" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AiSettingsButton"
                                    Content="AI 服务设置"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Click="AiSettingsButton_Click" />
                            <Button x:Name="AiLogsButton"
                                    Content="AI 翻译记录"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Click="AiLogsButton_Click"
                                    ToolTip="查看每次 AI 请求、原始回复和错误详情" />
                            <Button x:Name="TranslateSelectedButton"
                                    Content="翻译选中"
                                    Width="100"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Click="TranslateSelectedButton_Click" />
                            <Button x:Name="TranslatePendingButton"
                                    Content="批量翻译未翻译项"
                                    Width="150"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Click="TranslatePendingButton_Click" />
                            <Button x:Name="CancelTranslationButton"
                                    Content="取消翻译"
                                    Width="90"
                                    Height="32"
                                    IsEnabled="False"
                                    Click="CancelTranslationButton_Click" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="2">
                    <DataGrid x:Name="EntriesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              SelectionUnit="CellOrRowHeader"
                              SelectionMode="Extended"
                              IsReadOnly="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="EntriesDataGrid_SelectionChanged"
                              CurrentCellChanged="EntriesDataGrid_CurrentCellChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="编号" Width="82" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayKey}"
                                                   ToolTip="{Binding Key}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="语义组"
                                                Binding="{Binding SemanticGroupLabel}"
                                                IsReadOnly="True"
                                                Width="125" />
                            <DataGridTextColumn Header="原文"
                                                Binding="{Binding Original}"
                                                IsReadOnly="True"
                                                Width="2*" />
                            <DataGridTemplateColumn Header="译文" Width="2.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Translation}"
                                                   Padding="5,4"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Translation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsEditable}"
                                                 Padding="5,4"
                                                 MinHeight="32"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="翻译状态" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StageDescription}"
                                                   Padding="5,4"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding StageOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsEditable}"
                                                  MinWidth="120"
                                                  Padding="4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="76" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="编辑"
                                                Height="28"
                                                Padding="10,0"
                                                Margin="4,2"
                                                IsEnabled="{Binding IsEditable}"
                                                Click="EditTranslationButton_Click"
                                                ToolTip="打开完整译文编辑窗口" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="EmptyStateBorder" Background="#FAFBFC"
                            BorderBrush="#E3E6EA" BorderThickness="1" CornerRadius="6"
                            Margin="1" Visibility="Visible" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="24">
                            <TextBlock x:Name="EmptyStateTitleTextBlock" Text="尚未打开工作区"
                                       FontSize="20" FontWeight="SemiBold" Foreground="#39414A"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="EmptyStateDescriptionTextBlock" Margin="0,10,0,0"
                                       Text="选择原游戏目录和统一输出目录，然后打开工作区或提取字典。"
                                       FontSize="13" Foreground="#68717D" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                    </Grid>

                    <Border Grid.Row="3" Margin="0,10,0,0" Padding="10"
                            Background="#FAFBFC" BorderBrush="#E3E6EA" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="EntryGroupLabelTextBlock" Text="同组条目"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#39414A"
                                           Margin="0,0,0,4" />
                                <TextBox x:Name="EntryGroupTextBox" Grid.Row="1" IsReadOnly="True"
                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="当前词条没有可用的 ERB 语义分组信息。" />
                            </Grid>
                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeWE">
                                <GridSplitter.Template>
                                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                                        <Border Background="Transparent">
                                            <Border Width="2" HorizontalAlignment="Center"
                                                    Background="#D5DAE0" CornerRadius="1" />
                                        </Border>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="当前词条上下文" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#39414A" Margin="0,0,0,4" />
                                <TextBox x:Name="EntryContextTextBox" Grid.Row="1" IsReadOnly="True"
                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="选择一个词条查看上下文。" />
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
