<Window x:Class="EraTrans.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EraTrans"
        Width="1560"
        Height="1000"
        MinWidth="1200"
        MinHeight="760"
        Icon="pack://application:,,,/Assets/game-translator-icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        Closing="MainWindow_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="14,12,14,0"
                Padding="12,8"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ExtractButton"
                            Content="提取/更新字典"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Extract_Click" />
                    <Button x:Name="SaveCurrentDictionaryButton"
                            Content="保存字典"
                            Height="32"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="保存当前打开的字典文件（Ctrl+S）"
                            Click="SaveCurrentDictionary_Click" />
                    <Button x:Name="ApplyTranslationsButton"
                            Content="生成汉化副本"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="复制原游戏并写入已保存译文，不会改动原游戏"
                            Click="ApplyTranslations_Click" />
                    <Button x:Name="SettingsMenuButton"
                            Content="设置 ▾"
                            Height="32"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SettingsMenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SettingsContextMenu">
                                <MenuItem Header="解析与提取设置" Click="Settings_Click" />
                                <MenuItem Header="AI 服务设置" Click="AiSettingsMenuItem_Click" />
                                <Separator />
                                <MenuItem x:Name="AnalyzeGameCopyMenuItem" Header="汉化副本引擎体检" Click="AnalyzeGameCopyMenuItem_Click" />
                                <MenuItem Header="重新加载工作区" Click="ReloadWorkspaceMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="WorkspaceBadgeTextBlock"
                               Text="尚未选择工作区"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#20242A"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button x:Name="TogglePathsButton"
                            Content="目录设置 ▾"
                            Height="28"
                            FontSize="12"
                            Padding="10,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="展开或收起目录选择栏"
                            Click="TogglePathsButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="PathsDrawerBorder"
                Grid.Row="1"
                Margin="14,8,14,0"
                Padding="10,8"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="原游戏目录" FontSize="12" FontWeight="SemiBold"
                               Foreground="#39414A" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="GameDirectoryTextBox" Grid.Column="1" Height="30" IsReadOnly="True"
                             VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,6,0" />
                    <Button Grid.Column="2" x:Name="BrowseGameDirectoryButton" Content="浏览"
                            Height="30" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseGameDirectory_Click" />
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="统一输出目录" FontSize="12" FontWeight="SemiBold"
                               Foreground="#39414A" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="OutputDirectoryTextBox" Grid.Column="1" Height="30" IsReadOnly="True"
                             VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,6,0" />
                    <Button Grid.Column="2" x:Name="BrowseOutputDirectoryButton" Content="浏览"
                            Height="30" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseOutputDirectory_Click" />
                </Grid>
            </Grid>
        </Border>

        <ContentControl x:Name="EditorHost" Grid.Row="2" Margin="14,10,14,10" />

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="0,1,0,0"
                Padding="14,5">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="WorkspaceModeStatusText"
                           DockPanel.Dock="Right"
                           Margin="12,0,0,0"
                           FontSize="11"
                           Foreground="#68717D"
                           VerticalAlignment="Center"
                           Text="原游戏只读" />
                <ProgressBar x:Name="BusyProgressBar"
                             DockPanel.Dock="Left"
                             Width="110"
                             Height="6"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Foreground="#1971C2"
                             Background="#E9ECEF"
                             BorderThickness="0"
                             Visibility="Collapsed" />
                <TextBlock x:Name="StatusText"
                           FontSize="11.5"
                           Foreground="#59636F"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Text="请选择原游戏目录和输出目录" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
