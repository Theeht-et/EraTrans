<Window x:Class="EraTrans.App.ParserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解析与输出设置"
        Width="880"
        Height="940"
        MinWidth="720"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F5F6F8">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="解析与输出设置"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,5,0,0"
                       Text="配置分为四组：通用（两种抽取方式都生效）、新版设置、旧版设置、写回与翻译设置。设置保存在程序目录下的 Config/ 文件夹中。"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#68717D" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="通用设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"
                                   Margin="0,0,0,14" />

                        <TextBlock Grid.Row="1"
                                   Text="文本抽取方式"
                                   VerticalAlignment="Center"
                                   Foreground="#39414A" />
                        <ComboBox x:Name="ExtractionModeComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Height="34"
                                  Margin="0,0,0,6"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="ExtractionModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="旧版（按字符长相提取）" Tag="legacy" />
                            <ComboBoxItem Content="新版（仅提取玩家看得见的文本）" Tag="lexer" />
                        </ComboBox>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="只影响 ERB 脚本；CSV / RES / XML / ERD 始终由原有解析器处理。切换方式后必须重新提取，两版生成的字典内容不同，不能混用，建议用两个不同的字典目录。"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D"
                                   Margin="0,0,0,14" />

                        <TextBlock Grid.Row="3"
                                   Text="读取游戏文件编码"
                                   VerticalAlignment="Center"
                                   Foreground="#39414A" />
                        <ComboBox x:Name="EncodingComboBox"
                                  Grid.Row="3"
                                  Grid.Column="1"
                                  Height="34"
                                  Margin="0,0,0,6"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="UTF-8（含 BOM）" Tag="utf8-bom" />
                            <ComboBoxItem Content="UTF-8" Tag="utf8" />
                            <ComboBoxItem Content="Shift-JIS（日文）" Tag="932" />
                            <ComboBoxItem Content="GBK（简体中文）" Tag="936" />
                            <ComboBoxItem Content="Big5（繁体中文）" Tag="950" />
                        </ComboBox>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Text="旧版用它读取 CSV / ERB / RES；新版会逐文件自动探测（BOM、UTF-8、UTF-16、Shift-JIS），这里选的 GBK / Big5 只在文件既不是 UTF-8 也不是 Shift-JIS 时作为回退。混编游戏（同一目录里 UTF-8 与 Shift-JIS 混用）请让旧版改用能覆盖多数文件的值。"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D"
                                   Margin="0,0,0,14" />

                        <CheckBox x:Name="WriteContextCheckBox"
                                  Grid.Row="5"
                                  Content="提取字典时写入上下文"
                                  ToolTip="在词条中保存原脚本行作为上下文，供字典编辑和 AI 翻译参考。两种抽取方式都生效。"
                                  Foreground="#39414A" />
                        <CheckBox x:Name="AutoOpenFolderCheckBox"
                                  Grid.Row="5"
                                  Grid.Column="1"
                                  Content="处理完成后自动打开结果目录"
                                  ToolTip="提取完成后打开字典目录；应用译文完成后打开游戏副本目录。"
                                  Foreground="#39414A" />
                    </Grid>
                </Border>

                <Border x:Name="LexerSettingsPanel"
                        Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="新版（仅可见文本）"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />

                        <TextBlock Text="只在新版抽取方式下生效。"
                                   Margin="0,4,0,10"
                                   FontSize="11"
                                   Foreground="#68717D" />

                        <CheckBox x:Name="ExtractHtmlTitleCheckBox"
                                  Content="提取 HTML 的 title 提示文本"
                                  ToolTip="HTML_PRINT 里 title='…' 是鼠标悬停提示，玩家看得到。value= 是按钮返回值，不会提取。"
                                  Foreground="#39414A"
                                  Margin="0,0,0,10" />
                        <CheckBox x:Name="ExtractPrintDataEntriesCheckBox"
                                  Content="提取 PRINTDATA / DATALIST 数据块"
                                  ToolTip="PRINTDATA 会在运行时随机选一条 DATA / DATAFORM 显示，块内每条文本都会提取。"
                                  Foreground="#39414A"
                                  Margin="0,0,0,10" />
                        <CheckBox x:Name="SkipNonJapaneseEntriesCheckBox"
                                  Content="跳过不含日文的条目（纯英文、纯符号）"
                                  ToolTip="这些条目通常无需翻译。关闭后会把 &quot;OK&quot;、&quot;EXP+5&quot; 这类文本也放进字典。"
                                  Foreground="#39414A" />
                    </StackPanel>
                </Border>

                <Border x:Name="LegacySettingsPanel"
                        Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="旧版（旧版 ERB 解析器）"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />

                        <TextBlock Text="只在旧版抽取方式下生效；新版抽取器不使用这些开关（它只抽 PRINT 家族与数据流，不靠字符长相猜）。"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="HideEnglishTextCheckBox"
                                      Content="隐藏英文词条"
                                      ToolTip="纯英文条目会以 stage=-1 写入字典（不翻译、不显示）。"
                                      Margin="0,0,10,10"
                                      Foreground="#39414A" />
                            <CheckBox x:Name="MergeDuplicateEntriesCheckBox"
                                      Grid.Column="1"
                                      Content="合并同一文件中的相同词条"
                                      ToolTip="同一个脚本里重复出现的同一段文本只保留一条。"
                                      Margin="0,0,0,10"
                                      Foreground="#39414A" />
                            <CheckBox x:Name="HideVariableEntriesCheckBox"
                                      Grid.Row="1"
                                      Content="屏蔽变量词条输出"
                                      ToolTip="旧版会把疑似变量名的内容写成「变量」条目。保持开启时这些条目不会写入字典。"
                                      Margin="0,0,10,0"
                                      Foreground="#39414A" />
                            <CheckBox x:Name="MergeConcatenatedStringsCheckBox"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      Content="合并联立字符串"
                                      ToolTip="影响 CALL 等命令参数的拆分方式。实测对结果影响很小，建议保持默认。"
                                      Foreground="#39414A" />
                        </Grid>

                        <Expander Header="高级解析规则（仅旧版）"
                                  Margin="0,14,0,0"
                                  Foreground="#39414A">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="这两张表直接喂给旧版的表达式解析器，改错会让旧版抽取整体走样。除非你了解 ERA 表达式规则，否则保持默认。"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#68717D"
                                           Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="允许构成变量名的字符（每行一个）"
                                                   Margin="0,0,0,5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#39414A" />
                                        <TextBox x:Name="VariableNameCharactersTextBox"
                                                 Height="150"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 Padding="8"
                                                 FontFamily="Consolas" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="需要处理的操作符（每行一个）"
                                                   Margin="0,0,0,5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#39414A" />
                                        <TextBox x:Name="OperatorsTextBox"
                                                 Height="150"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 Padding="8"
                                                 FontFamily="Consolas" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="写回设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />
                        <TextBlock Text="写回阶段与抽取方式无关。新版字典按位置精确替换；旧版字典、CSV / RES / XML / ERD 仍按原文匹配。"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D" />

                        <CheckBox x:Name="EnableVariableAutoCorrectionCheckBox"
                                  Content="变量自动修正"
                                  ToolTip="写回完成后，读取下面列出的 CSV 字典，把其中的译文对全部 ERB / ERH / ERD 再做一次全局替换（用于翻译变量名、能力名等）。这是全局正则替换，可能影响台词中的同名文本。"
                                  Foreground="#39414A"
                                  Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="游戏文件扩展名（每行一个）"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBox x:Name="TargetFileExtensionsTextBox"
                                         Height="92"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Padding="8"
                                         FontFamily="Consolas" />
                                <TextBlock Text="必须包含 .erb，否则 ERB 译文会被静默跳过。"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#68717D" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="变量自动修正参考文件（每行一个）"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBox x:Name="AutoReplaceReferenceFilesTextBox"
                                         Height="92"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Padding="8"
                                         FontFamily="Consolas" />
                                <TextBlock Text="填写 CSV 字典文件名，不带 .json。"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="#68717D" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="AI 翻译方式"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />

                        <CheckBox x:Name="EnableErbSemanticGroupingTranslationCheckBox"
                                  Content="按原文顺序整段翻译（按屏分窗）"
                                  ToolTip="关闭时：按字典顺序每 12 条一批，不做任何顺序分析。开启时：按 ERB 的「一屏」切窗口，同一屏的连续内容一起发送，绝不跨屏切断；需要当前字典配有分组文件（新版抽取会自动生成）。"
                                  Margin="0,12,0,6"
                                  Foreground="#39414A" />

                        <TextBlock Text="两种方式共用同一套提示词与返回格式，区别只在于每一批包含哪些行。开启后需要当前字典配有分组文件；缺失或过期时会直接提示。"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="每个窗口的字符上限"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBox x:Name="WindowMaxCharactersTextBox"
                                         Height="32"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="默认 3000。越小越精细，请求次数越多。" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="每个窗口的行数上限"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBox x:Name="WindowMaxLinesTextBox"
                                         Height="32"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="默认 60。只作辅助限制，防止短行把窗口拉得过长。" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="同时发送的请求数"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold"
                                           Foreground="#39414A" />
                                <TextBox x:Name="TranslationConcurrencyTextBox"
                                         Height="32"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="1–50，默认 1（逐个发送）。调高可同时发送多个窗口，按服务商限流情况自行调整。" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="前两个上限只影响「按原文顺序整段翻译」；固定批次方式固定为每批 12 条。并发数对两种方式都生效。"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#68717D" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="修改后点击保存，下一次提取或应用译文时生效。"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#87909B"
                       FontSize="11" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="保存设置"
                        Width="100"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="Save_Click" />
                <Button Content="取消"
                        Width="82"
                        Height="36"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
