<Window x:Class="EraTrans.App.AiProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 服务商设置"
        Width="820"
        Height="700"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F6F8">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="AI 翻译服务商"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,5,0,0"
                       Text="可直接选择常见服务商模板，也可以自定义接口。支持 OpenAI 兼容协议，以及 Google Gemini、Anthropic Claude 原生 API。"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#68717D" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="20"
                Background="White"
                BorderBrush="#E1E5E9"
                BorderThickness="1"
                CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="配置方案"
                           VerticalAlignment="Center"
                           Foreground="#39414A" />
                <ComboBox x:Name="ProviderComboBox"
                          Grid.Column="1"
                          Height="34"
                          DisplayMemberPath="Name"
                          SelectionChanged="ProviderComboBox_SelectionChanged" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="10,0,0,0">
                    <Button Content="新增"
                            Width="58"
                            Height="34"
                            Margin="0,0,6,0"
                            Click="AddProvider_Click" />
                    <Button Content="删除"
                            Width="58"
                            Height="34"
                            Click="RemoveProvider_Click" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="服务商模板"
                           VerticalAlignment="Center"
                           Margin="0,15,0,0"
                           Foreground="#39414A" />
                <ComboBox x:Name="ProviderPresetComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Height="34"
                          Margin="0,15,0,0"
                          DisplayMemberPath="Name"
                          SelectionChanged="ProviderPresetComboBox_SelectionChanged"
                          ToolTip="选择模板后会自动填写服务商名称、协议和 API 地址；API Key 需要自行填写。" />

                <TextBlock Grid.Row="2"
                           Text="接口协议"
                           VerticalAlignment="Center"
                           Margin="0,15,0,0"
                           Foreground="#39414A" />
                <ComboBox x:Name="ProtocolComboBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Height="34"
                          Margin="0,15,0,0"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Value"
                          SelectionChanged="ProtocolComboBox_SelectionChanged" />

                <TextBlock Grid.Row="3"
                           Text="服务商名称"
                           VerticalAlignment="Center"
                           Margin="0,15,0,0"
                           Foreground="#39414A" />
                <TextBox x:Name="NameTextBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="34"
                         Margin="0,15,0,0"
                         VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="4"
                           Text="API Base URL"
                           VerticalAlignment="Center"
                           Margin="0,15,0,0"
                           Foreground="#39414A" />
                <TextBox x:Name="BaseUrlTextBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="34"
                         Margin="0,15,0,0"
                         VerticalContentAlignment="Center"
                         ToolTip="请按所选服务商区域和协议填写 Base URL；不要附加具体模型或请求路径。" />

                <TextBlock Grid.Row="5"
                           Text="API Key"
                           VerticalAlignment="Center"
                           Margin="0,15,0,0"
                           Foreground="#39414A" />
                <PasswordBox x:Name="ApiKeyPasswordBox"
                             Grid.Row="5"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             Height="34"
                             Margin="0,15,0,0"
                             VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="6"
                           Text="翻译模型"
                           VerticalAlignment="Center"
                           Margin="0,15,0,0"
                           Foreground="#39414A" />
                <TextBox x:Name="ModelTextBox"
                         Grid.Row="6"
                         Grid.Column="1"
                         Height="34"
                         Margin="0,15,8,0"
                         VerticalContentAlignment="Center"
                         ToolTip="可手动填写模型 ID，也可以点击右侧按钮获取模型列表。" />
                <Button x:Name="FetchModelsButton"
                        Grid.Row="6"
                        Grid.Column="2"
                        Content="获取模型列表"
                        Width="126"
                        Height="34"
                        Margin="0,15,0,0"
                        Click="FetchModels_Click" />

                <Border Grid.Row="7"
                        Grid.ColumnSpan="3"
                        Margin="0,14,0,0"
                        Padding="10,9"
                        Background="#F6F7F9"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock x:Name="ModelCountTextBlock"
                                   Text="模型列表尚未获取。"
                                   FontSize="12"
                                   Foreground="#39414A" />
                        <TextBlock x:Name="ProtocolHintTextBlock"
                                   Margin="0,4,0,0"
                                   Text="OpenAI 兼容服务商通过 Chat Completions 工作。"
                                   FontSize="11"
                                   Foreground="#7A8490"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="8"
                           Grid.ColumnSpan="3"
                           Margin="0,12,0,0"
                           VerticalAlignment="Top"
                           TextWrapping="Wrap"
                           Foreground="#68717D"
                           FontSize="12" />
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="API Key 使用当前 Windows 用户 DPAPI 加密保存。服务商模板仅预填接口资料，不会自动创建或提供 API Key。"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#7A8490"
                       FontSize="11" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button x:Name="TestButton"
                        Content="测试连接"
                        Width="92"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="TestConnection_Click" />
                <Button Content="保存"
                        Width="82"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="Save_Click" />
                <Button Content="取消"
                        Width="82"
                        Height="36"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
