<Window x:Class="EraTrans.App.EncodingIssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编码预检发现问题文件"
        Width="860"
        Height="560"
        MinWidth="640"
        MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="HeaderTextBlock"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#20242A"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DescriptionTextBlock"
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="#59636F"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="10,8"
                Margin="0,0,0,12"
                Background="#FFF8EB"
                BorderBrush="#F0D39C"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock x:Name="BehaviorNoteTextBlock"
                       FontSize="12"
                       Foreground="#6B4F1D"
                       TextWrapping="Wrap" />
        </Border>

        <DataGrid x:Name="IssuesDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#ECEFF3"
                  Background="White"
                  BorderBrush="#D5DAE0"
                  BorderThickness="1"
                  RowBackground="White"
                  AlternatingRowBackground="#FAFBFC"
                  SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件路径"
                                    Binding="{Binding RelativePath}"
                                    Width="260" />
                <DataGridTextColumn Header="原因说明"
                                    Binding="{Binding Reason}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Margin" Value="4,4,4,4" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="复制清单"
                        Width="92"
                        Height="34"
                        Click="CopyList_Click" />
                <TextBlock x:Name="CopiedHintTextBlock"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#2E7D32" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="IgnoreContinueButton"
                        Height="34"
                        Padding="14,0"
                        Margin="0,0,10,0"
                        Style="{StaticResource DangerOutlineButtonStyle}"
                        Click="IgnoreAndContinue_Click" />
                <Button Content="取消（去手动转码）"
                        Height="34"
                        Padding="16,0"
                        IsDefault="True"
                        IsCancel="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
