<UserControl x:Class="EraTrans.App.DictionaryEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6F8"
             PreviewKeyDown="Control_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="190" MaxWidth="480" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="White"
                    BorderBrush="#E3E6EA"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="字典文件"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />
                        <TextBlock x:Name="DictionaryDirectoryTextBlock"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="#87909B"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="WorkspaceProgressTextBlock"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#39414A"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="FileTreeSearchTextBox"
                                         Height="28"
                                         VerticalContentAlignment="Center"
                                         Padding="6,0"
                                         FontSize="12"
                                         ToolTip="输入文件名或路径关键词筛选左侧字典树"
                                         TextChanged="FileTreeSearchTextBox_TextChanged" />
                                <TextBlock x:Name="FileTreeSearchPlaceholder"
                                           Text="筛选字典文件…"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#9AA3AE"
                                           IsHitTestVisible="False" />
                            </Grid>
                            <ComboBox x:Name="FileTreeStatusFilterComboBox"
                                      Grid.Column="1"
                                      Height="28"
                                      Margin="6,0,0,0"
                                      VerticalContentAlignment="Center"
                                      FontSize="11"
                                      ToolTip="按文件翻译进度筛选左侧字典树"
                                      SelectionChanged="FileTreeStatusFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="全部" Tag="all" />
                                <ComboBoxItem Content="未完成" Tag="incomplete" />
                                <ComboBoxItem Content="未翻译" Tag="not_started" />
                                <ComboBoxItem Content="翻译中" Tag="in_progress" />
                                <ComboBoxItem Content="已完成" Tag="completed" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    <TreeView x:Name="DictionaryFilesTreeView"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="DictionaryFilesTreeView_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Resources>
                            <Style x:Key="CompactTreeExpanderToggleStyle" TargetType="{x:Type ToggleButton}">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Width" Value="14" />
                                <Setter Property="Height" Value="18" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent" Padding="3,4,2,4">
                                                <Path x:Name="ExpandPath"
                                                      Data="M 0 0 L 4 4 L 0 8 Z"
                                                      Fill="#68717D"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ExpandPath" Property="Data" Value="M 0 2 L 8 2 L 4 6 Z" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ExpandPath" Property="Fill" Value="#20242A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#20242A" />
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ToggleButton x:Name="Expander"
                                                              Grid.Row="0"
                                                              Grid.Column="0"
                                                              ClickMode="Press"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                              Style="{StaticResource CompactTreeExpanderToggleStyle}" />
                                                <Border x:Name="Bd"
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="Center"
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                Margin="10,0,0,0" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                </Trigger>
                                                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F0F2F5" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#DCEBFA" />
                                                    <Setter Property="Foreground" Value="#132F4C" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True" />
                                                        <Condition Property="IsSelectionActive" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="#E8ECF0" />
                                                    <Setter Property="Foreground" Value="#20242A" />
                                                </MultiTrigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#9AA3AE" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Cursor="SizeWE"
                          ToolTip="拖动调整左侧文件夹区域宽度">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Border Background="Transparent">
                            <Border Width="2"
                                    HorizontalAlignment="Center"
                                    Background="#D5DAE0"
                                    CornerRadius="1" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Border Grid.Column="2"
                    Padding="14,12,14,10"
                    Background="White"
                    BorderBrush="#E3E6EA"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="148" MinHeight="84" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="126" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedFileTextBlock"
                                       Text="请选择左侧字典文件"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#20242A" />
                            <TextBlock x:Name="SummaryTextBlock"
                                       Margin="0,3,0,0"
                                       Text="尚未加载字典"
                                       FontSize="12"
                                       Foreground="#68717D" />
                        </StackPanel>
                        <ComboBox x:Name="EntryFilterComboBox"
                                  Grid.Column="1"
                                  Height="30"
                                  Margin="8,0,0,0"
                                  VerticalContentAlignment="Center"
                                  FontSize="12"
                                  ToolTip="按翻译状态、校验告警或文本类型筛选当前字典词条"
                                  SelectionChanged="EntryFilterComboBox_SelectionChanged">
                            <ComboBoxItem Content="全部词条" Tag="all" />
                            <ComboBoxItem Content="未翻译" Tag="pending" />
                            <ComboBoxItem Content="已翻译" Tag="translated" />
                            <ComboBoxItem Content="有校验告警" Tag="warning" />
                            <ComboBoxItem Content="按钮与界面" Tag="ui" />
                        </ComboBox>
                        <Grid Grid.Column="2" Margin="8,0,0,0">
                            <TextBox x:Name="EntrySearchTextBox"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     ToolTip="搜索 key、原文、译文、类型、分组或上下文（Ctrl+F）"
                                     TextChanged="EntrySearchTextBox_TextChanged" />
                            <TextBlock x:Name="EntrySearchPlaceholder"
                                       Text="搜索词条（Ctrl+F）…"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#9AA3AE"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="推理"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       FontSize="12"
                                       Foreground="#68717D" />
                            <ComboBox x:Name="AiReasoningComboBox"
                                      Width="78"
                                      Height="28"
                                      Padding="6,0"
                                      VerticalContentAlignment="Center"
                                      FontSize="12"
                                      SelectionChanged="AiReasoningComboBox_SelectionChanged"
                                      DropDownOpened="AiReasoningComboBox_DropDownOpened"
                                      ToolTip="自动：使用服务商默认设置。开启/关闭：向请求附加当前服务商对应的推理字段。">
                                <ComboBoxItem Content="自动" Tag="auto" />
                                <ComboBoxItem Content="开启" Tag="on" />
                                <ComboBoxItem Content="关闭" Tag="off" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TranslateSelectedButton"
                                    Content="翻译选中"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="TranslateSelectedButton_Click" />
                            <Button x:Name="TranslatePendingButton"
                                    Content="批量翻译"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="按原文顺序批量翻译当前字典中所有未翻译项"
                                    Click="TranslatePendingButton_Click" />
                            <Button x:Name="CancelTranslationButton"
                                    Content="取消翻译"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Visibility="Collapsed"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="CancelTranslationButton_Click" />
                            <Button x:Name="ToolsMenuButton"
                                    Content="工具与统计 ▾"
                                    Height="30"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ToolsMenuButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="ToolsContextMenu">
                                        <MenuItem x:Name="ProgressStatsMenuItem"
                                                  Header="翻译进度统计…"
                                                  IsEnabled="False"
                                                  Click="ProgressStatsButton_Click" />
                                        <MenuItem x:Name="CoverageReportMenuItem"
                                                  Header="提取覆盖率自检报告…"
                                                  Visibility="Collapsed"
                                                  Click="CoverageReportButton_Click" />
                                        <Separator />
                                        <MenuItem x:Name="AiSettingsMenuItem"
                                                  Header="AI 服务设置…"
                                                  Click="AiSettingsButton_Click" />
                                        <MenuItem x:Name="AiLogsMenuItem"
                                                  Header="AI 翻译记录…"
                                                  Click="AiLogsButton_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="EntriesDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  SelectionUnit="CellOrRowHeader"
                                  SelectionMode="Extended"
                                  IsReadOnly="False"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="EntriesDataGrid_SelectionChanged"
                                  CurrentCellChanged="EntriesDataGrid_CurrentCellChanged">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="打开完整译文编辑窗口 (Ctrl+E)"
                                              Click="EditSelectedTranslationMenuItem_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="编号" Width="56" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayKey}"
                                                       ToolTip="{Binding Key}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Padding="2,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="屏 / 分组"
                                                    Binding="{Binding SemanticGroupLabel}"
                                                    IsReadOnly="True"
                                                    Width="92">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="类型"
                                                    Binding="{Binding EntryTypeLabel}"
                                                    IsReadOnly="True"
                                                    Width="56">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="原文"
                                                    Binding="{Binding Original}"
                                                    IsReadOnly="True"
                                                    Width="2*" />
                                <DataGridTemplateColumn Header="译文" Width="2.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Translation}"
                                                           Padding="5,4"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="⚠"
                                                           Foreground="#C87500"
                                                           FontWeight="Bold"
                                                           Margin="4,0,6,0"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding ValidationWarning}"
                                                           Visibility="{Binding HasValidationWarning, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Translation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsEditable}"
                                                     Padding="5,4"
                                                     MinHeight="32"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="翻译状态" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StageDescription}"
                                                       Padding="4,4"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding StageOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsEditable}"
                                                      HorizontalAlignment="Stretch"
                                                      Padding="2,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="EmptyStateBorder" Background="#FAFBFC"
                                BorderBrush="#E3E6EA" BorderThickness="1" CornerRadius="6"
                                Margin="1" Visibility="Visible" IsHitTestVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="24">
                                <TextBlock x:Name="EmptyStateTitleTextBlock" Text="尚未打开工作区"
                                           FontSize="20" FontWeight="SemiBold" Foreground="#39414A"
                                           TextAlignment="Center" />
                                <TextBlock x:Name="EmptyStateDescriptionTextBlock" Margin="0,10,0,0"
                                           Text="选择原游戏目录和统一输出目录，然后打开工作区或提取字典。"
                                           FontSize="13" Foreground="#68717D" TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Row="3"
                                  Height="8"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="False"
                                  Cursor="SizeNS"
                                  ToolTip="拖动调整底部预览区高度">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="{x:Type GridSplitter}">
                                <Border Background="Transparent">
                                    <Border Height="2"
                                            VerticalAlignment="Center"
                                            Background="#D5DAE0"
                                            CornerRadius="1" />
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <Border Grid.Row="4" Padding="10"
                            Background="#FAFBFC" BorderBrush="#E3E6EA" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,4">
                                    <CheckBox x:Name="ScreenPreviewCheckBox"
                                              DockPanel.Dock="Right"
                                              Content="整屏预览"
                                              FontSize="11"
                                              Foreground="#59636F"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed"
                                              Checked="ScreenPreviewCheckBox_Changed"
                                              Unchecked="ScreenPreviewCheckBox_Changed"
                                              ToolTip="勾选后显示当前一整屏（WAIT/INPUT 之间）的全部条目；取消勾选则只显示当前语义小组" />
                                    <TextBlock x:Name="EntryGroupLabelTextBlock" Text="同组条目"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#39414A"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBox x:Name="EntryGroupTextBox" Grid.Row="1" IsReadOnly="True"
                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="当前词条没有可用的 ERB 语义分组信息。" />
                            </Grid>
                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeWE">
                                <GridSplitter.Template>
                                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                                        <Border Background="Transparent">
                                            <Border Width="2" HorizontalAlignment="Center"
                                                    Background="#D5DAE0" CornerRadius="1" />
                                        </Border>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="当前词条上下文" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#39414A" Margin="0,0,0,4" />
                                <TextBox x:Name="EntryContextTextBox" Grid.Row="1" IsReadOnly="True"
                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="选择一个词条查看上下文。" />
                            </Grid>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="5" Margin="0,6,0,0" LastChildFill="True">
                        <TextBlock x:Name="AiProviderStatusTextBlock"
                                   DockPanel.Dock="Right"
                                   Margin="12,0,0,0"
                                   Foreground="#68717D"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="AI 翻译未配置" />
                        <TextBlock x:Name="StatusTextBlock"
                                   Foreground="#68717D"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Text="就绪（右键词条或按 Ctrl+E 可打开完整译文编辑窗口）" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
